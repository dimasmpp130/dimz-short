{
  "redirects": [
    {
      "source": "/admins.html",
      "destination": "/admins",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admins",
      "destination": "/admins.html"
    },
    {
      "source": "/:alias([A-Za-z0-9_-]{4,32})",
      "destination": "/index.html?alias=$1"
    }
  ]
}
