{
  "redirects": [
    {
      "source": "/shortlink.html",
      "destination": "/shortlink",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/shortlink",
      "destination": "/shortlink.html"
    },
    {
      "source": "/:alias([A-Za-z0-9_-]{4,32})",
      "destination": "/shortlink.html?alias=$1"
    }
  ]
}